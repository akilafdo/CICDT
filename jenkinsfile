pipeline {
  agent any

  stages {
    stage('Build') {
      steps {
        sh 'docker build -t mini-cicd:jenkins .'
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          docker rm -f mini-cicd || true
          docker run -d --name mini-cicd -p 8080:8080 mini-cicd:jenkins
        '''
      }
    }

    stage('Smoke Test') {
      steps {
        sh 'sleep 2 && curl -f http://localhost:8080'
      }
    }
  }
}
